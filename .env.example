# .env.example
#
# Copy this file to .env and fill in real values for your machine:
#     cp .env.example .env
#
# RULES
#   * NEVER commit .env or any real secret. Make sure .env is in .gitignore.
#   * Every variable the app reads must be listed here with a safe sample value.
#   * Add a matching row in docs/ENVIRONMENT.md when you add a variable here.
#   * Values below are fake. "change_me" means you must set a real value.

# ---------- App ----------
APP_NAME=[project_name]
APP_ENV=development              # development | test | staging | production
APP_HOST=0.0.0.0
APP_PORT=8000
APP_DEBUG=true                   # must be false in staging and production
LOG_LEVEL=INFO                   # DEBUG | INFO | WARNING | ERROR
ALLOWED_ORIGINS=http://localhost:3000

# ---------- Security ----------
SECRET_KEY=change_me             # at least 32 random characters
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=60

# ---------- Database ----------
DATABASE_URL=postgresql://user:password@localhost:5432/[db_name]
DATABASE_POOL_SIZE=10
# For MongoDB use: mongodb://localhost:27017/[db_name]

# ---------- Cache and queue ----------
REDIS_URL=redis://localhost:6379/0

# ---------- Third party services ----------
# Use sandbox or test keys outside production.
[SERVICE_NAME]_API_KEY=change_me
[SERVICE_NAME]_BASE_URL=https://sandbox.example.com
EMAIL_SMTP_HOST=localhost
EMAIL_SMTP_PORT=1025
STORAGE_BUCKET=[bucket_name]

# ---------- Monitoring ----------
SENTRY_DSN=
METRICS_ENABLED=false

# ---------- Feature flags ----------
FEATURE_[NAME]_ENABLED=false

# ---------- LLM and ML (remove if not used) ----------
LLM_PROVIDER=[provider]
LLM_API_KEY=change_me
LLM_MODEL=[model_name]
LLM_TIMEOUT_SECONDS=30
